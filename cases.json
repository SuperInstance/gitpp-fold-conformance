  {
   "name": "d25-numeric-string-vs-number",
   "why": "A record whose effect is the STRING \"1.5e20\" must not be confused with the NUMBER 1.5e20. JSON::PP hands Perl a bare scalar for both, so looks_like_number() was true for both and the string was emitted UNQUOTED -- a leaf defect. Here the string record is the descendant, so it wins by §5.2, and the state must carry the STRING through untouched. If a port coerces it to a number, state.x comes back as 1.5e20 and this case fails -- which is exactly the regression we want to catch.",
   "records": [
    {
     "id": "num",
     "kind": "task",
     "parents": [],
     "effects": {
      "x": 1.5e+20
     },
     "reason": null
    },
    {
     "id": "str",
     "kind": "task",
     "parents": [
      "num"
     ],
     "effects": {
      "x": "1.5e20"
     },
     "reason": null
    }
   ],
   "expect": {
    "state": {
     "x": "1.5e20"
    },
    "order": [
     "num",
     "str"
    ],
    "conflicts": [
     {
      "key": "x",
      "winner": "str",
      "losers": [
       "num"
      ]
     }
    ],
    "orphans": []
   }
